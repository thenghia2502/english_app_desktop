{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "English App Desktop",
  "version": "0.1.0",
  "identifier": "com.sandbox.englishapp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:49321",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPLOCALDATA/**",
          "$RESOURCE/**"
        ]
      }
    },
    "windows": [
      {
        "title": "English App Desktop Sandbox",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "maximized": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico"
    ]
  }
}