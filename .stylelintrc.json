{
    "extends": [
        "stylelint-config-standard"
    ],
    "overrides": [
        {
            "files": [
                "**/*.css"
            ],
            "customSyntax": "postcss-scss",
            "rules": {
                "at-rule-no-unknown": [
                    true,
                    {
                        "ignoreAtRules": [
                            "tailwind",
                            "apply",
                            "responsive",
                            "screen",
                            "import",
                            "layer"
                        ]
                    }
                ]
            }
        }
    ]
}